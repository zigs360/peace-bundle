# ==========================================
# Peace Bundle - DigitalOcean Full Stack
# (Frontend, Backend, Database on Droplet)
# ==========================================

# ------------------------------------------
# Domain & SSL Settings (DigitalOcean Droplet)
# ------------------------------------------
# Main website domain (e.g. peacebundlle.com)
DOMAIN_NAME=peacebundlle.com
# Optional API subdomain (e.g. api.peacebundlle.com)
API_DOMAIN=api.peacebundlle.com
# Email address for Let's Encrypt renewal alerts
SSL_EMAIL=admin@peacebundlle.com

# ------------------------------------------
# Custom Web Server Ports (default 3080 & 3443 to avoid port 80/443 conflicts)
# ------------------------------------------
HTTP_PORT=3080
HTTPS_PORT=3443

# ------------------------------------------
# Frontend URL
# ------------------------------------------
FRONTEND_URL=https://peacebundlle.com

# ------------------------------------------
# Database Settings (Self-Hosted PostgreSQL on Droplet)
# ------------------------------------------
POSTGRES_DB=peacebundlle
POSTGRES_USER=peacebundlle_user
POSTGRES_PASSWORD=replace_with_a_strong_password_here
# DATABASE_URL is constructed automatically in docker-compose.yml:
# postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
DB_SSL=false
DB_SYNC=safe
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_POOL_ACQUIRE_MS=30000

# ------------------------------------------
# Application Core Settings
# ------------------------------------------
NODE_ENV=production
PORT=5000
JWT_SECRET=replace_with_a_secure_random_64_char_string
REQUEST_TIMEOUT_MS=120000
REQUIRE_SERVICE_KEYS=false

# ------------------------------------------
# Telecom & VTU API Credentials
# ------------------------------------------
# SMEPlug (Airtime & Data)
SMEPLUG_API_KEY=
SMEPLUG_PRIVATE_KEY=
SMEPLUG_SECRET_KEY=
SMEPLUG_BASE_URL=https://smeplug.ng

# OGDAMS (Data & Call Bundles)
OGDAMS_API_KEY=
OGDAMS_BASE_URL=

# ------------------------------------------
# Payment Gateway & Virtual Accounts
# ------------------------------------------
# Payvessel
PAYVESSEL_API_KEY=
PAYVESSEL_SECRET_KEY=
PAYVESSEL_BUSINESS_ID=

# Billstack
BILLSTACK_BASE_URL=https://api.billstack.co
BILLSTACK_SECRET_KEY=
BILLSTACK_PUBLIC_KEY=
BILLSTACK_WEBHOOK_SECRET=

# Safehaven (Virtual Accounts)
SAFEHAVEN_BASE_URL=https://api.safehavenmfb.com
SAFEHAVEN_ACCESS_TOKEN=
SAFEHAVEN_CLIENT_ID=

# ------------------------------------------
# SMTP Email Settings
# ------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM="Peace Bundlle <support@peacebundlle.com>"
